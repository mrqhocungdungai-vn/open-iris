{
  "name": "open-iris",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "src/main/main.mjs",
  "scripts": {
    "dev": "LOG_LEVEL=debug electronmon .",
    "start": "electron .",
    "build": "electron-packager . open-iris --icon=assets/icon.icns --app-bundle-id=com.open-iris.app --app-version=0.1.0 --no-asar --no-prune --out=out --overwrite --ignore='^/(\\.env|\\.hallmark|\\.agents|\\.claude|docs|eval|node_modules/(\\.pnpm/)?(electron|@electron)[^/]*)($|/)'",
    "postinstall": "[ \"$(uname)\" != Darwin ] || for k in CFBundleName CFBundleDisplayName; do plutil -replace $k -string open-iris node_modules/electron/dist/Electron.app/Contents/Info.plist; done",
    "test": "node --test src/gesture/*.test.mjs src/main/desktop.selftest.mjs src/main/persona.selftest.mjs src/main/listen.selftest.mjs src/main/live-config.selftest.mjs src/renderer/devices.test.mjs",
    "fetch-model": "mkdir -p models && curl -fsSL -o models/hand_landmarker.task https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task"
  },
  "dependencies": {
    "@google/genai": "2.10.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "agent-desktop": "1.3.1",
    "pnpm": "^12.21.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "42.5.0",
    "electronmon": "^2.0.4"
  }
}
